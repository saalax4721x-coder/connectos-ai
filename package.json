    "verify:nexus": "vitest run src/nexus",
    "verify:opportunities": "vitest run src/opportunities",
    "verify:graph": "vitest run src/graph",
    "verify:agents": "vitest run src/agents",
    "verify:workflows": "vitest run src/workflows",
    "verify:memory": "vitest run src/memory",
    "verify:autopilot": "vitest run src/autopilot",
    "verify:intent": "vitest run src/intent",
    "verify:context": "vitest run src/context",
    "verify:research": "vitest run src/research"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.57.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": ">=22.18.0"}
}
